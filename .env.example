# Any OpenAI-compatible endpoint works. Copy this file to .env and fill it in.

# Local, free: Ollama (https://ollama.com). The key can be any text.
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=gemma4:12b

# Optional: a stronger model for the coach and the hint check. Leave empty to use AI_MODEL.
COACH_MODEL=

# Optional: a hosted provider instead, for example
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=your-key
# AI_MODEL=<a larger model on that provider>

CLIENT_TEMPERATURE=0.5
COACH_TEMPERATURE=0.2

# Turns off hidden "thinking". Needed for Gemma 4 and Qwen 3.5 on Ollama, which otherwise spend the whole answer
# on it and reply with nothing. Clear it for a hosted provider that rejects the setting.
AI_REASONING_EFFORT=none

# Optional: extra JSON sent with every request.
AI_EXTRA_BODY=

# Ollama's OpenAI endpoint ignores num_ctx, so set the context window on the server instead:
#   OLLAMA_CONTEXT_LENGTH=16384 ollama serve
# and check the CONTEXT column of `ollama ps`. The default (4096) can cut off the coach's prompt.
